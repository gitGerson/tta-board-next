APP_NAME="Tong Tji Starter Kit"
APP_VERSION="1.4.0"

# Local PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tta_board
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=public

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Use ldaps:// in production. Plain ldap:// is development-only.
LDAP_URL=ldaps://ldap.example.com:636
LDAP_BIND_DN=cn=readonly,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=ou=Users,dc=example,dc=com
LDAP_USER_ATTRIBUTE=uid
LDAP_NAME_ATTRIBUTE=cn
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_GUID_ATTRIBUTE=entryUUID
LDAP_CONNECT_TIMEOUT_MS=5000
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_ALLOW_INSECURE=false
